h3 Quick Commands Buttons

.form-line
    .header
        .title Disable tabs
        .description Show commands as a single flat list instead of grouping them into tabs

    toggle.ml-1(
        title="Show commands as a single flat list instead of grouping them into tabs",
        [(ngModel)]='config.store.quickCmdBtnPlugin.disableTabs',
        (ngModelChange)='config.save()'
    )

.form-line
    .header
        .title Use system theme
        .description Follow Tabby's active theme for the panel colors

    toggle.ml-1(
        title="Follow Tabby's active theme for the panel colors",
        [(ngModel)]='config.store.quickCmdBtnPlugin.useSystemTheme',
        (ngModelChange)='config.save()'
    )
